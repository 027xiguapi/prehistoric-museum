{
  "name": "prehistoric-animal-museum",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "review": "npm run validate:review && node scripts/set-env.mjs NEXT_PUBLIC_MUSEUM_MODE=review MUSEUM_BASE_PATH= tsx scripts/serve-review.ts",
    "build": "npm run generate:remote-assets && next build",
    "build:e2e": "npm run validate:content && node scripts/set-env.mjs NEXT_PUBLIC_MUSEUM_MODE=e2e MUSEUM_BASE_PATH=/prehistoric-animal-museum next build",
    "build:mobile": "node scripts/set-env.mjs NEXT_STATIC_EXPORT=1 next build && node scripts/strip-remote-assets.mjs",
    "generate:remote-assets": "node scripts/generate-remote-assets.mjs",
    "sync:version": "node scripts/sync-native-version.mjs",
    "cap:sync": "npm run sync:version && npm run build:mobile && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "cap:assets": "npx @capacitor/assets generate --android --ios --assetPath resources",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "optimize:models": "node scripts/optimize-runtime-models.mjs",
    "generate:model-previews": "tsx scripts/render-model-previews.ts --target=production",
    "generate:animal-social-images": "tsx scripts/generate-animal-social-images.ts",
    "generate:backgrounds": "tsx scripts/generate-animal-backgrounds.ts",
    "generate:backgrounds:dry-run": "tsx scripts/generate-animal-backgrounds.ts --dry-run",
    "adopt:backgrounds": "tsx scripts/adopt-generated-backgrounds.ts",
    "generate:seo-social-cards": "node --import tsx scripts/generate-seo-social-cards.ts",
    "generate:registry": "tsx scripts/generate-content-registry.ts",
    "generate:review-model-previews": "tsx scripts/render-model-previews.ts --target=review",
    "typecheck": "tsc --noEmit --pretty false",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:model-previews": "tsx scripts/validate-model-previews.ts --target=production",
    "validate:review-model-previews": "tsx scripts/validate-model-previews.ts --target=review",
    "validate:review": "tsx scripts/validate-review-assets.ts && npm run validate:review-model-previews",
    "generate:credits": "tsx scripts/generate-credits.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/zcool-kuaile": "5.3.0",
    "lucide-react": "1.27.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "playwright": "1.62.0",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
